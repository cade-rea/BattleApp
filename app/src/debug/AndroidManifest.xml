<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk to a PvP server on the local network over plain ws://, since it
     runs on a computer without a certificate until it's hosted. Release builds can't. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
