<?xml version="1.0" encoding="utf-8"?>

<com.caderea.battleapp.view.battle.BattleViewGroup
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/battleViewGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <com.caderea.battleapp.view.battle.queue.QueueDrawer
            android:id="@+id/player1QDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    <com.caderea.battleapp.view.battle.queue.QueueDrawer
            android:id="@+id/player2QDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    <ProgressBar
            android:id="@+id/tickProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="50"/>

    <com.caderea.battleapp.view.battle.BattleDrawArea
        android:id="@+id/battleDrawArea"
        android:layout_height="wrap_content"
        android:layout_width="match_parent">

        <TextView
            android:id="@+id/battleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/battleLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:padding="8dp"
            android:textSize="12sp"/>

    </com.caderea.battleapp.view.battle.BattleDrawArea>

    <com.caderea.battleapp.view.battle.BattleInputArea
        android:id="@+id/battle_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/button1"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="Button 1"/>

        <Button
            android:id="@+id/button2"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="Button 2"/>

        <Button
            android:id="@+id/button3"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="Button 3"/>

        <Button
            android:id="@+id/button4"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="Button 4"/>

        <Button
            android:id="@+id/buttonStop"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Stop"/>

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/button_cancel"/>

    </com.caderea.battleapp.view.battle.BattleInputArea>

</com.caderea.battleapp.view.battle.BattleViewGroup>