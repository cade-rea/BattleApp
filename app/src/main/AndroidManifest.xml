<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- online matches talk to the PvP server -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.BattleActivity"
            android:exported="false"
            android:label="@string/title_activity_battle_screen" >
        </activity>
        <activity
            android:name=".activity.LoadoutActivity"
            android:exported="false"
            android:label="@string/loadout_title" />
        <activity
            android:name=".activity.CharactersActivity"
            android:exported="false"
            android:label="@string/characters_title" />
        <activity
            android:name=".activity.CharacterCreationActivity"
            android:exported="false"
            android:label="@string/create_title"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.ArenasActivity"
            android:exported="false"
            android:label="@string/arenas_title" />
        <activity
            android:name=".activity.OnlineActivity"
            android:exported="false"
            android:label="@string/online_title"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.OnlineBattleActivity"
            android:exported="false"
            android:label="@string/online_title" />
    </application>

</manifest>
